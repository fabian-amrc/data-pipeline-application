@prefix dpa: <https://data-pipeline.local/ontology/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .

# Placeholder example only. Replace with source-specific mappings.
<#DatasetMapping>
    a rr:TriplesMap ;
    dpa:unityCatalogObject "unity.default.example_dataset" ;
    dpa:unityCatalogStorageLocation "s3://delta/example-dataset" ;
    dpa:unityCatalogColumn "id:INT:Dataset identifier" ;
    dpa:unityCatalogColumn "name:STRING:Display name" ;
    dpa:unityCatalogColumn "age:INT:Example numeric attribute" ;
    dpa:unityCatalogColumn "city:STRING:Example city attribute" ;
    rml:logicalSource [
        rml:source "s3a://delta/example-dataset" ;
        rml:referenceFormulation <http://semweb.mmlab.be/ns/ql#CSV>
    ] ;
    rr:subjectMap [
        rr:template "https://data-pipeline.local/resource/dataset/{id}" ;
        rr:class dpa:Dataset
    ] .
